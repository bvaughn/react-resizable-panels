{
  "description": [
    {
      "content": "<p>A Cell occupies one or more tracks (columns and rows) within a Grid.\nCells are resized along with the tracks they occupy.</p>\n"
    },
    {
      "content": "<p>Cell elements always include the following attributes:</p>\n"
    },
    {
      "content": "<div><span class=\"tok-punctuation\">&#60;</span><span class=\"tok-typeName\">div</span><span class=\"\"> </span><span class=\"tok-propertyName\">data-cell</span><span class=\"\"> </span><span class=\"tok-propertyName\">data-testid</span><span class=\"tok-operator\">=</span><span class=\"tok-string\">\"cell-id-prop\"</span><span class=\"\"> </span><span class=\"tok-propertyName\">id</span><span class=\"tok-operator\">=</span><span class=\"tok-string\">\"cell-id-prop\"</span><span class=\"tok-punctuation\">&#62;</span></div>"
    },
    {
      "content": "<p><a href=\"https://testing-library.com/docs/queries/bytestid/\">Test id</a> can be used to narrow selection when unit testing.</p>\n",
      "intent": "primary"
    },
    {
      "content": "<p>Cell elements must be direct DOM children of their parent Grid elements.</p>\n",
      "intent": "warning"
    }
  ],
  "filePath": "lib/components/grid/Cell.tsx",
  "name": "Cell",
  "props": {
