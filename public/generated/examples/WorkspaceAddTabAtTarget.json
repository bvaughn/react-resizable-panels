{
  "html": "<div><span class=\"tok-comment\">// In a new tabset below the \"grid\" tabset, taking 30% of the split it's in</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-variableName\">workspace</span><span class=\"tok-operator\">.</span><span class=\"tok-propertyName\">addTab</span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName\">tab</span><span class=\"tok-punctuation\">,</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-propertyName tok-definition\">size</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-string\">\"30%\"</span><span class=\"tok-punctuation\">,</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-propertyName tok-definition\">target</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">region</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-string\">\"bottom\"</span><span class=\"tok-punctuation\">,</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">tabsetId</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-string\">\"grid\"</span><span class=\"\"> </span><span class=\"tok-punctuation\">}</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-punctuation\">}</span><span class=\"tok-punctuation\">)</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div>&nbsp;</div>\n<div><span class=\"\"></span><span class=\"tok-comment\">// In a new tabset along the bottom of the workspace, 200 pixels tall</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-variableName\">workspace</span><span class=\"tok-operator\">.</span><span class=\"tok-propertyName\">addTab</span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName\">tab</span><span class=\"tok-punctuation\">,</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">size</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-string\">\"200px\"</span><span class=\"tok-punctuation\">,</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">target</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">edge</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-string\">\"bottom\"</span><span class=\"\"> </span><span class=\"tok-punctuation\">}</span><span class=\"\"> </span><span class=\"tok-punctuation\">}</span><span class=\"tok-punctuation\">)</span><span class=\"tok-punctuation\">;</span></div>"
